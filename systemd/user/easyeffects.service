[Unit]
Description=Audio Effects for Pipewire applications
PartOf=graphical-session.target
After=graphical-session.target waybar.service

[Service]
# ponytail: waybar's tray has no unit to wait on, so just give it a moment to claim the StatusNotifier host
ExecStartPre=/usr/bin/sleep 2
ExecStart=/usr/bin/easyeffects --hide-window --service-mode
Restart=on-failure

[Install]
WantedBy=graphical-session.target
